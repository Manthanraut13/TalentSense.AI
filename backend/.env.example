# App
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# AI (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=2048

# Vector DB (Qdrant)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=resume_analyses
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Document DB (MongoDB)
MONGODB_URI=
MONGODB_DATABASE=resume_analyzer
MONGODB_COLLECTION=analyses
# Privacy: store first 500 chars of resume in history (default false)
STORE_RESUME_SNIPPET=false

# Clerk Authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=noreply@resumeanalyzer.app
APP_URL=http://localhost:5173/

# Learning roadmap resource search
TAVILY_API_KEY=

# Observability (Sentry)
SENTRY_DSN=
ENVIRONMENT=development

# Rate limiting (10 analyses per day by default)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=86400

# Test mode (bypasses auth for local testing)
TEST_MODE=false
